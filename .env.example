# ── Runtime mode ───────────────────────────────────────────────────────────────
# Set to "production" on deploy — enforces required secrets at startup
ENV=development

# ── Neon PostgreSQL (LangGraph checkpoints) ───────────────────────────────────
# Runtime: pooled URL (hostname contains "-pooler") — same DB as the dashboard.
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Client-side pool cap for psycopg ConnectionPool (default 5, max 20)
DATABASE_POOL_MAX_SIZE=5

# ── AI / LLM ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
# Optional alias (llm.py accepts either)
GOOGLE_API_KEY=""

# ── Dashboard integration ─────────────────────────────────────────────────────
DASHBOARD_URL="https://your-dashboard-domain.com"
CATALOG_API_URL="https://your-dashboard-domain.com/api/internal/catalog"
INTERNAL_API_KEY="change-me"
BRAIN_API_KEY="change-me"

# CORS — comma-separated origins (default includes http://localhost:3000)
ALLOWED_ORIGINS="http://localhost:3000,https://your-dashboard-domain.com"

# ── Vector DB (Pinecone) ──────────────────────────────────────────────────────
PINECONE_API_KEY=""
INDEX_NAME="ai-sale"

# ── Payments (Slip2Go) ────────────────────────────────────────────────────────
SLIP_VERIFY_SECRET=""
SLIP2GO_API_URL=""
PROMPTPAY_CODE=""
PROMPTPAY_TYPE="NATID"
PROMPTPAY_ACCOUNT_NAME=""

# ── LINE (optional — dashboard can push instead) ───────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_PUSH_FROM_BRAIN=false
PUBLIC_APP_URL="https://your-dashboard-domain.com"

# ── Observability (optional) ──────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="ai-sales"
